# ==========================================
# CodeJudge Environment Configuration Template
# ==========================================

# -----------------
# Database (PostgreSQL)
# -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=codejudge
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# -----------------
# Cache & Message Broker (Redis)
# -----------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------
# Backend API (NestJS)
# -----------------
PORT=5000
FRONTEND_URL=http://localhost:3000

# Security: Mandatory Cryptographically Strong JWT Secrets (Must be set, no fallbacks)
JWT_SECRET=generate_strong_64_char_secret_for_access_tokens
JWT_REFRESH_SECRET=generate_strong_64_char_secret_for_refresh_tokens

# Google Gemini AI Integration (Optional: static fallback used if not configured)
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------
# Execution Worker
# -----------------
TEMP_DIR=/tmp/codejudge

# -----------------
# Frontend (Next.js)
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
