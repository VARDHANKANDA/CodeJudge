# ==========================================
# CodeJudge Environment Configuration Template
# ==========================================

# -----------------
# Database (PostgreSQL / Neon)
# -----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=codejudge
DATABASE_URL=postgresql://user:password@ep-sample-pooler.neon.tech/codejudge?sslmode=require

# -----------------
# Cache & Message Broker (Redis / Render / Upstash)
# -----------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Alternatively, specify a full Redis URI (e.g. rediss://default:token@host:port)
REDIS_URL=

# -----------------
# Backend API (NestJS)
# -----------------
PORT=5000
FRONTEND_URL=https://code-judge-three.vercel.app,http://localhost:3000

# Security: Mandatory Cryptographically Strong JWT Secrets (Must be set, no fallbacks)
JWT_SECRET=your_super_secret_access_jwt_key_at_least_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters

# First Admin User Bootstrap Configuration
ADMIN_EMAIL=admin@codejudge.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Google Gemini AI Integration (Optional: static analysis fallback used if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------
# Execution Worker (BullMQ + Docker Sandbox)
# -----------------
TEMP_DIR=/tmp/codejudge

# -----------------
# Frontend (Next.js)
# -----------------
# For Local Dev: http://localhost:5000/api
# For Production: https://codejudge-backend-zh9l.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
